{
  "data_release": "v1_r1",
  "defaults": {
    "config_version": "ehr_modeling_v1",
    "protocol_id": "ehr_r02_catboost_four_candidates_raw_rmse_v1",
    "experiment_status": "independent_rebuild_after_prior_test_exposure",
    "seed": 42,
    "model": {
      "family": "CatBoostRegressor",
      "task_type": "CPU",
      "loss_function": "RMSE",
      "eval_metric": "RMSE",
      "iterations": 500,
      "learning_rate": 0.03,
      "early_stopping_rounds": 50,
      "use_best_model": true,
      "thread_count": 1,
      "allow_writing_files": false,
      "verbose": false
    },
    "preprocessing": {
      "feature_order": "schema_numeric_then_categorical",
      "numeric_missing": "catboost_native_nan",
      "categorical_missing": "__MISSING__",
      "unknown_categories": "catboost_native_string_hashing"
    },
    "selection": {
      "prediction_column": "predicted_score",
      "primary_metric": "pooled_oof_rmse",
      "tie_breakers": [
        "pooled_oof_mae",
        "depth_ascending",
        "l2_leaf_reg_descending"
      ]
    },
    "postprocessing": {
      "raw_column": "predicted_score",
      "processed_column": "postprocessed_score",
      "clip_range": [
        0.0,
        8.0
      ],
      "role": "secondary_reporting_only"
    },
    "final_model": {
      "scheme": "single_model_refit_on_all_development",
      "round_rule": "median_best_rounds_half_up",
      "use_best_model": false,
      "early_stopping_rounds": null
    },
    "evaluation": {
      "endpoints": [
        "phys_death",
        "high_burden"
      ],
      "auprc_method": "average_precision_score",
      "threshold_prediction_column": "predicted_score",
      "threshold_rule": "highest_finite_oof_threshold_meeting_sensitivity",
      "sensitivity_target": 0.8,
      "bootstrap_unit": "subject_id",
      "bootstrap_draws": 2000,
      "bootstrap_seed": 42,
      "confidence_level": 0.95,
      "confidence_interval": "percentile",
      "single_class_bootstrap": "skip_auroc_and_ap_record_valid_and_skipped"
    }
  },
  "experiments": [
    {
      "id": "d2_l210",
      "description": "d2_l210 (baseline)",
      "parameters": {
        "candidate": {
          "name": "d2_l210",
          "depth": 2,
          "l2_leaf_reg": 10
        }
      }
    },
    {
      "id": "d2_l230",
      "description": "d2_l230 (baseline)",
      "parameters": {
        "candidate": {
          "name": "d2_l230",
          "depth": 2,
          "l2_leaf_reg": 30
        }
      }
    },
    {
      "id": "d3_l210",
      "description": "d3_l210 (baseline)",
      "parameters": {
        "candidate": {
          "name": "d3_l210",
          "depth": 3,
          "l2_leaf_reg": 10
        }
      }
    },
    {
      "id": "d3_l230",
      "description": "d3_l230 (baseline)",
      "parameters": {
        "candidate": {
          "name": "d3_l230",
          "depth": 3,
          "l2_leaf_reg": 30
        }
      }
    }
  ]
}
