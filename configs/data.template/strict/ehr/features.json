{
  "algorithm_version": "ehr_features_v1",
  "lookback_hours": 24,
  "memory_limit": "2GB",
  "static_features": [
    "age_at_t0",
    "sex",
    "admission_type",
    "admission_location",
    "careunit_at_t0",
    "current_service",
    "hours_from_admission"
  ],
  "aggregations": [
    "last_24h",
    "min_24h",
    "max_24h",
    "mean_24h",
    "count_24h",
    "hours_since_last"
  ],
  "tables": {
    "patients": "hosp/patients.csv",
    "admissions": "hosp/admissions.csv",
    "services": "hosp/services.csv"
  },
  "max_temp_directory_size": "4GB",
  "workspace_estimate_bytes": 8589934592
}
